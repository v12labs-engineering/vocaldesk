# Application
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Supabase (required for authentication and application data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Bland AI (required for phone-agent and call features)
BLAND_API_URL=https://api.bland.ai/v1
BLAND_API_KEY=your-bland-api-key
BLAND_WEBHOOK_SECRET=your-bland-webhook-secret
TWILIO_ENCRYPTED_KEY=your-bland-twilio-encrypted-key

# OAuth integrations (optional)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_CALENDLY_OAUTH_CLIENT_ID=your-calendly-oauth-client-id
CALENDLY_OAUTH_CLIENT_SECRET=your-calendly-oauth-client-secret
NEXT_PUBLIC_CALENDLY_AUTH_BASE_URL=https://auth.calendly.com

# Notifications and external integrations (optional)
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
JILLS_OFFICE_API=https://api.example.com
JILLS_OFFICE_API_KEY=your-integration-api-key

# Exact HTTPS hostnames that signed-in users may call from the API request tester.
# Leave blank to disable outbound test requests.
API_PROXY_ALLOWED_HOSTS=api.example.com

# Remote Supabase CLI commands only (not needed for local application startup)
SUPABASE_PROJECT_REF=your-project-reference
SUPABASE_DB_PASSWORD=your-database-password

# Supabase Edge Function secret name used by refresh_tokens/index.ts.
SERVICE_ROLE_KEY=your-supabase-service-role-key
